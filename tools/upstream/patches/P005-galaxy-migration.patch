+        val log = SessionLogFile(File(folder, "debug.log"), listOf("debug-previous.log", "debug-previous-2.log"))
+        try {
+            log.reset("session=first")
+            repeat(550) { log.append("stage=音频 count=$it " + "界".repeat(650)) }
