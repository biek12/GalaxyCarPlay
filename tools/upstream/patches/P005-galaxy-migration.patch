+                paint.xfermode=null;paint.shader=null;canvas.restoreToCount(layer)
+            }
+        }
+        tools.label(canvas,"地图演示",w*.08f,h*.96f,minOf(16f,h*.06f),Color.GRAY,w*.3f,Paint.Align.LEFT)
+    }
+    fun clear(){variants.clear()}
+}
