+    val slots: Int,
+    val openTimeoutMillis: Int,
+) {
+    init {
+        require(virtualScreenId.isNotBlank())
+        require(nativeDisplayId >= 0)
+        require(width >= 16 && height >= 16)
+        require(nativeOpenMagic >= 0)
+        require(fps in 1..60)
+        require(slots in 2..8)
+        require(openTimeoutMillis in 1..60_000)
+    }
+
+    companion object {
+        /**
