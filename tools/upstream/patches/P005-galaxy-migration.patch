+            assertTrue(AsyncDiagnosticLog.awaitIdle(2_000))
+            assertTrue(current.file.readText().contains("stage=after-clear"))
+            assertFalse(current.file.readText().contains("before-clear"))
+            assertFalse(old.file.exists())
+            old.close()
