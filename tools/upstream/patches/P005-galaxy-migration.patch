+        val p = item.properties; val w = item.node.rect.width; val h = item.node.rect.height
+        rect.set(0f, 0f, w, h); path.reset()
+        when (p.string("shape")) {
+            "circle" -> path.addCircle(w / 2, h / 2, min(w, h) / 2, Path.Direction.CW)
