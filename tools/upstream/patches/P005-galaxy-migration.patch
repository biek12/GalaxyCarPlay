+        check(result.optString("state") in setOf("authorized", "already_authorized")) { "adb_bootstrap_authorization_failed" }
+        prepareTls(work) { !work.cancelled.get() && !closed && ServiceFeatures.read(context).let { it.adb && it.root } }
