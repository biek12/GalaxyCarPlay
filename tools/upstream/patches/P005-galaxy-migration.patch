+        } catch (_: IllegalStateException) { assertEquals(original, file.readText()) }
+    }
+    @Test fun authorizationRecoveryCanReloadAlreadyPresentKeyWithoutDuplicatingIt() = fixture { file ->
+        file.writeText(own + "\n")
