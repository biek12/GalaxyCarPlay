+            }.setNegativeButton(R.string.l7_listen_skip) { _, _ -> controller.answer(sample.id, "SKIP"); dialog = null; update() }
+            .setOnCancelListener { controller.answer(sample.id, "SKIP"); dialog = null; update() }.show()
