+        } catch (error: Exception) {
+            foundationEvidence = JSONObject().put("state", "failed").put("stage", "adb_connection_failed").toString()
+            com.ecarx.autoservice.ServiceTrace.event("adb_connection_failed", error)
+            throw error
+        }
+    }
