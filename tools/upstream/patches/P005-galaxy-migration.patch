@@ -0,0 +1,85 @@
+<resources>
+    <string name="debug_guide_title">操作引导</string>
+    <string name="debug_guide_begin">开始分步引导</string>
+    <string name="debug_guide_again">重新引导</string>
+    <string name="debug_guide_next">已完成，下一步</string>
+    <string name="debug_guide_help">查看本步提示／定位控件</string>
+    <string name="debug_guide_progress">第 %1$d / %2$d 步 · %3$s</string>
+    <string name="debug_guide_intro">每次只做一个操作；遇到问题也能记录，再继续下一步。</string>
+    <string name="debug_guide_wait">先完成本步操作再继续。无法完成时请明确记录，不能当作通过。</string>
+    <string name="debug_guide_locate">去操作／开始观察</string>
+    <string name="debug_guide_missing">无法完成，记录并跳过</string>
+    <string name="debug_guide_hide">收起提示</string>
+    <string name="debug_guide_finished">引导结束 · %1$d 步未完成。证据已在日志中，请手动上传。</string>
+    <string name="debug_guide_prepare">准备测试</string>
+    <string name="debug_guide_prepare_body">请停车后操作，确认车型与连接方式。真实手机测试先连接 CarPlay；媒体／导航样例测试先断开手机。打开引导不会启动测试。</string>
+    <string name="debug_guide_listen">开始监听</string>
+    <string name="debug_guide_listen_body">点击高亮的“开始监听”。在两分钟内逐个测试实体按键，每次只按一个，松开后等待标注窗口。</string>
+    <string name="debug_guide_keys">按键并标注</string>
+    <string name="debug_guide_keys_body">依次测试左右切歌、播放／暂停、语音短按／长按、音量加减。每次输入出现后按实际按键标注，重复键可继续采集；没有输入请点击“按了，但没有收到”。不要用软件模拟键代替实体键。</string>
+    <string name="debug_guide_stop">结束并检查恢复</string>
+    <string name="debug_guide_stop_body">点击结束／停止，等待状态停止。检查声音、播放与原车页面是否恢复；停止请求不等于资源已释放。</string>
+    <string name="debug_guide_logs">回传测试日志</string>
+    <string name="debug_guide_logs_body">完成或记录缺失后，进入日志页手动上传。请同时说明车型、连接方式、操作顺序和实际现象；不用填写密码、设备身份或语音内容。</string>
+    <string name="debug_guide_local">测试本地麦克风</string>
+    <string name="debug_guide_local_body">先授予录音权限，再点击开始测试，对着车机说一句普通话。观察电平后停止或等十秒结束。电平正常仅证明本地输入，不代表 Siri 已识别。</string>
+    <string name="debug_guide_siri">唤起 Siri 并记录结果</string>
+    <string name="debug_guide_siri_body">保持真实 CarPlay 连接，先停止本地录音，再点击唤起 Siri。说一句简单指令，在手机和车机观察后点击“响应正常”或“未响应／异常”。没有手机可记录缺失。</string>
+    <string name="debug_guide_report">开始样例上报</string>
+    <string name="debug_guide_report_body">点击开始上报并确认。等待本次样例出现；样例为固定测试数据。服务调用返回不能证明原车媒体卡片、仪表或 HUD 已显示。</string>
+    <string name="debug_guide_observe">对照样例记录结果</string>
+    <string name="debug_guide_observe_body">对照“本次样例”，在原车对应页面查看，回来点击“已显示”或“未显示／异常”。再逐项更新并观察。样例变化后必须重新判断，旧判断不能沿用。</string>
+    <string name="debug_guide_cleanup">确认原车清理结果</string>
+    <string name="debug_guide_cleanup_body">点击结束上报，等待实际本地清理完成，再检查原车页面是否撤除样例。回来选择“已清除”或“仍残留／异常”。</string>
+    <string name="debug_guide_codec">运行固定视频样例</string>
+    <string name="debug_guide_codec_body">保持手机断开，选择视频样例与解码路径，点击运行当前项。观察预览是否连续变化，有没有黑屏、花屏或卡住；软件对照不代表车机硬件通过。</string>
+    <string name="debug_guide_codec_result">记录画面观察</string>
+    <string name="debug_guide_codec_result_body">等待当前项结束，核对本次结果。Surface 出帧后记录画面；缓冲区输出没有画面，失败或跳过可继续查看日志。逐项单独运行，才能分别记录每次判断。</string>
+    <string name="debug_guide_collect">收集环境检查</string>
+    <string name="debug_guide_collect_body">点击收集检查，等待任务弹窗完成。检查失败时阅读具体原因；可在弹窗停止。报告描述环境事实，不代表真实手机连接或车辆显示通过。</string>
+    <string name="debug_guide_scenario">故障复现引导</string>
+    <string name="debug_guide_scenario_hint">USB、热点、黑屏、音频／通话与蓝牙交接，逐步记录操作和现象</string>
+    <string name="debug_guide_mark">记录操作已执行</string>
+    <string name="debug_guide_ok">本步现象正常</string>
+    <string name="debug_guide_bad">未出现／异常</string>
+    <string name="debug_guide_scenario_action">操作步骤</string>
+    <string name="debug_guide_scenario_result">实际现象</string>
+    <string name="debug_guide_usb_body">连接 iPhone 数据线，打开有线连接；观察连接、提示与是否闪退。保持线缆不动，回来记录首次连接结果。</string>
+    <string name="debug_guide_wifi_body">在 Android 原生设置开启热点，手机保持 Wi-Fi 与蓝牙打开，启动无线连接。观察热点、发现和投屏是否成功。回来记录首次无线连接结果。</string>
+    <string name="debug_guide_video_body">连接 CarPlay 后连续观察画面；记录是否黑屏、卡住或正常播放；设置往返在下一步测试。出现故障先记录，不要立即重启以免丢失现场。</string>
+    <string name="debug_guide_audio_body">播放音乐，触发导航播报，再进行一次通话和 Siri 请求；分别记录声音位置、是否断音与结束后音乐能否恢复。原车蓝牙音乐需按实际听感记录。</string>
+    <string name="debug_guide_bt_body">确认目标手机连接原车蓝牙，保持 CarPlay 投屏；先播放音乐并观察出声；按键和通话在后续步骤测试。记录原车和手机是否出现音源争抢或无声。</string>
+    <string name="debug_key_left">上一曲／左键</string>
+    <string name="debug_key_right">下一曲／右键</string>
+    <string name="debug_key_play">播放／暂停键</string>
+    <string name="debug_key_voice_short">语音短按</string>
+    <string name="debug_key_voice_long">语音长按</string>
+    <string name="debug_key_volume_up">音量加</string>
+    <string name="debug_key_volume_down">音量减</string>
+    <string name="debug_key_left_body">本步只测试“上一曲／左键”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_right_body">本步只测试“下一曲／右键”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_play_body">本步只测试“播放／暂停键”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_voice_short_body">本步只测试“语音短按”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_voice_long_body">本步只测试“语音长按”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_volume_up_body">本步只测试“音量加”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_key_volume_down_body">本步只测试“音量减”。按一次后松开（长按按实际习惯），等待输入标注窗口并选择对应实体键。观察手机与车机实际反应，再选择“本步现象正常”或“未出现／异常”。没有输入请点击“按了，但没有收到”，本步会记录缺失。</string>
+    <string name="debug_scenario_choose">选择要复现的问题</string>
+    <string name="debug_scenario_connect_usb">连接 USB</string>
+    <string name="debug_scenario_usb_recover">拔插后恢复</string>
+    <string name="debug_scenario_usb_recover_body">先记录首次连接现象，再拔掉数据线；观察连接是否退出。重新插入并启动同一连接，观察是否恢复、卡住或闪退。完成后回到这里记录实际结果。</string>
+    <string name="debug_scenario_wifi_recover">无线重连</string>
+    <string name="debug_scenario_wifi_recover_body">先记录首次无线连接现象。保留相同热点配置，断开后重连，观察发现、握手和画面恢复。完成后回到这里记录结果，不要反复改密码或切换模式。</string>
+    <string name="debug_scenario_video_switch">设置往返与画面恢复</string>
+    <string name="debug_scenario_video_switch_body">在投屏正常或故障时进入设置，再返回投屏。观察画面是否恢复、有无锁死；记录切换后的实际现象。仅在本步记录后再尝试手动恢复。</string>
