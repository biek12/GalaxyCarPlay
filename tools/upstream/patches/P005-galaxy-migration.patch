+        var completions = 0
+        var release: (() -> Unit)? = null
+        CarPlayBackgroundSession.store(controller, sink, 1440, 1800, Any(), display()) {
+            requests++
+            release = it
+        }
+        CarPlayBackgroundSession.stop { completions++ }
+        CarPlayBackgroundSession.stop { completions++ }
