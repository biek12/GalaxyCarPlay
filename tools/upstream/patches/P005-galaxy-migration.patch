@@ -0,0 +1,85 @@
+<resources>
+    <string name="debug_guide_title">Step-by-step guide</string>
+    <string name="debug_guide_begin">Start guided test</string>
+    <string name="debug_guide_again">Start guide again</string>
+    <string name="debug_guide_next">Done · next step</string>
+    <string name="debug_guide_help">Show instructions / locate control</string>
+    <string name="debug_guide_progress">Step %1$d of %2$d · %3$s</string>
+    <string name="debug_guide_intro">Follow one action at a time. Record missing results and continue.</string>
+    <string name="debug_guide_wait">Complete this action before continuing. Record a missing result if blocked; it is not a pass.</string>
+    <string name="debug_guide_locate">Locate control / observe</string>
+    <string name="debug_guide_missing">Record missing · skip</string>
+    <string name="debug_guide_hide">Hide instructions</string>
+    <string name="debug_guide_finished">Guide finished · %1$d missing steps. Evidence is in Logs; upload manually.</string>
+    <string name="debug_guide_prepare">Prepare</string>
+    <string name="debug_guide_prepare_body">Park before testing and confirm the vehicle and connection. Connect CarPlay for phone tests; disconnect it for media / navigation samples. Opening this guide does not start a test.</string>
+    <string name="debug_guide_listen">Start listening</string>
+    <string name="debug_guide_listen_body">Tap the highlighted Start listening control. Test one physical button at a time within two minutes; release it and wait for the label dialog.</string>
+    <string name="debug_guide_keys">Press and label</string>
+    <string name="debug_guide_keys_body">Test previous / next, play / pause, short / long voice presses, and volume up / down. Label each received input with the actual button. Repeat as needed; tap No input received if nothing arrives. Use physical buttons.</string>
+    <string name="debug_guide_stop">Stop and check recovery</string>
+    <string name="debug_guide_stop_body">Tap End / Stop and wait for the stopped state. Check sound, playback and the vehicle display. A stop request does not prove resource release.</string>
+    <string name="debug_guide_logs">Return test logs</string>
+    <string name="debug_guide_logs_body">After completing or recording missing steps, open Logs and upload manually. Describe the vehicle model, connection method, action order and observed behavior. Omit passwords, device identities and spoken content.</string>
+    <string name="debug_guide_local">Test the local microphone</string>
+    <string name="debug_guide_local_body">Grant microphone permission, tap Start test and speak toward the car microphone. Watch the level; stop or wait ten seconds. A normal level proves local input, not Siri recognition.</string>
+    <string name="debug_guide_siri">Request Siri and record the result</string>
+    <string name="debug_guide_siri_body">Keep a real CarPlay connection and stop local recording before requesting Siri. Say a simple command; observe the phone and car, then choose Responded or Missing / abnormal. Record missing if no phone is available.</string>
+    <string name="debug_guide_report">Start sample reporting</string>
+    <string name="debug_guide_report_body">Tap Start reporting and confirm. Wait for the current fixed test sample. An API return does not prove display on the vehicle media card, cluster or HUD.</string>
+    <string name="debug_guide_observe">Compare and record the result</string>
+    <string name="debug_guide_observe_body">Compare Current sample with the vehicle display, then choose Visible or Missing / abnormal. Change each field and observe again. Each changed sample needs a new judgment.</string>
+    <string name="debug_guide_cleanup">Confirm vehicle display cleanup</string>
+    <string name="debug_guide_cleanup_body">End reporting and wait for local cleanup. Check whether the sample disappeared from the vehicle display, then choose Cleared or Residual / abnormal.</string>
+    <string name="debug_guide_codec">Run a fixed video sample</string>
+    <string name="debug_guide_codec_body">Disconnect the phone, choose a sample and decoder path, then run the current case. Watch for motion, black frames, corruption or stalls. A software result does not prove vehicle hardware support.</string>
+    <string name="debug_guide_codec_result">Record the visual result</string>
+    <string name="debug_guide_codec_result_body">Wait for the case to finish and check its result. Surface output requires your picture judgment. Buffer output has no picture; failures and skipped cases can continue to logs. Repeat each path separately to record each judgment.</string>
+    <string name="debug_guide_collect">Collect environment checks</string>
+    <string name="debug_guide_collect_body">Tap Collect checks and wait for the task dialog. Read specific failure reasons; stop from the dialog if needed. The report describes environment facts, not a successful phone connection or vehicle display.</string>
+    <string name="debug_guide_scenario">Guided reproduction</string>
+    <string name="debug_guide_scenario_hint">Step through USB, hotspot, video, audio / calls and Bluetooth handoff</string>
