+        try {
+            for (names in listOf(emptyList(), listOf("../elsewhere.log"), listOf("debug.log"),
+                listOf("same.log", "same.log"))) {
+                assertTrue(runCatching { SessionLogFile(File(folder, "debug.log"), names) }.isFailure)
+            }
+        } finally { folder.deleteRecursively() }
