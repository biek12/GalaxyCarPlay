# 本地构建、IDE与运行材料
.gradle/
.kotlin/
.idea/
*.iml
local.properties
**/build/
**/.cxx/
**/.externalNativeBuild/
.work/
.DS_Store
__pycache__/
*.pyc

# 参考仓库与研究材料不作为产品源码提交
/references/
# /.local 整体是本机研究/反编译/现场材料目录（含约1.5G快照与截图）。文档里引用它是
# “证据保存在本机忽略目录”，不是要求入库；子目录也一并覆盖，避免漏配时把大体积材料提交。
/.local/

# 身份、签名、设备记录与分发产物不入库
.private/
.env
.env.*
*.jks
*.keystore
*.pk8
*.p7b
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab
*.log

# Go 构建产物
server/galaxyd/galaxyd

# Local evidence must never be committed
/tools/evidence/

# Local collaborator staging files
/.workbuddy/
