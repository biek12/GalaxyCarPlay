<?xml version="1.0" encoding="UTF-8"?>
<!-- 自写设计草案：运行时、组件与预设尚未实现；不进入APK，不是Android布局XML。 -->
<cluster-theme schemaVersion="1" status="draft" id="classic-map-music"
    name="指针 · 地图 · 歌词" designWidth="1920" designHeight="532" fit="contain">
    <render-policy mode="content-aware" maxFps="60" animationFps="30" mapFps="source"
        static="on-change" keepAliveMs="1000"/>
    <appearance mode="auto" day="day" night="night" shareDayNight="false"/>
    <styles>
        <palette id="night" foreground="#EFF5F8" muted="#9AAAB2" accent="#1F9EFF"/>
        <palette id="day" foreground="#13252F" muted="#50646F" accent="#006FC7"/>
        <component-style id="dial" component="needle-gauge" preset="clean-dial"/>
        <override component="lyrics" mode="day" foreground="#13252F" fontScale="1.05"/>
        <override component="speed" mode="night" foreground="#38B4FF"/>
    </styles>
    <animations>
        <!-- needleFraction属于装饰指针；不回写vehicle.displaySpeed。 -->
        <animation id="intro" preset="needle-sweep" property="introNeedleFraction" durationMs="1400">
            <keyframe at="0" value="0"/>
            <keyframe at="0.5" value="1"/>
            <keyframe at="1" value="0"/>
        </animation>
        <animation id="follow" preset="follow-value" durationMs="100"/>
        <animation id="line-change" preset="lyrics-scroll" durationMs="420"/>
    </animations>
    <scene>
        <component id="map" type="map-viewport" x="0" y="0" width="1920" height="532" z="0"
            source="navigation.map" scale="contain"/>
        <component id="speed" type="needle-gauge" x="65" y="95" width="445" height="375" z="10"
            style="dial" bind="vehicle.displaySpeed" unit="km/h" min="0" max="260"
            startAngle="135" sweepAngle="270" valueAnimation="follow">
            <on event="sceneFirstVisible" animation="intro" guard="stationaryFresh" once="sceneSession"/>
        </component>
        <component id="speed-number" type="value-text" x="200" y="245" width="180" height="100" z="11"
            bind="vehicle.displaySpeed" unit="km/h" invalidText="--"/>
        <component id="track" type="track-info" x="1320" y="100" width="530" height="90" z="10"
            bind="media.track"/>
        <component id="lyrics" type="lyrics" x="1320" y="195" width="530" height="230" z="10"
            bind="media.lyrics" clock="media.playback" lines="5" transition="line-change"/>
        <component id="progress" type="media-progress" x="1320" y="440" width="530" height="40" z="10"
            bind="media.playback"/>
    </scene>
</cluster-theme>
