<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <application android:label="AutoCluster" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".ClusterActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|uiMode">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ThemeActivity" android:exported="false" android:configChanges="orientation|screenSize|uiMode" />
        <activity android:name=".BackgroundImagePicker" android:exported="false" android:configChanges="orientation|screenSize|uiMode" />
        <service android:name=".ClusterRenderService" android:exported="true" android:permission="com.ecarx.autoservice.permission.RENDER" android:foregroundServiceType="connectedDevice" />
    </application>
    <permission android:name="com.ecarx.autoservice.permission.RENDER" android:protectionLevel="signature" />
</manifest>
