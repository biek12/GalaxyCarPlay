<?xml version="1.0" encoding="utf-8"?>
<!-- 原厂增强页：音乐卡片与背景两个入口、固定说明与运行状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include android:id="@+id/page_header" layout="@layout/include_cluster_page_header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/oem_note" style="@style/GalaxyUi.TextAppearance.Description" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/cluster_note_padding_vertical" android:paddingBottom="@dimen/cluster_note_padding_vertical" android:text="@string/cluster_oem_note"/>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/oem_entries_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/oem_music_entry" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_oem_music_entry"/>
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/oem_background_entry" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_oem_background_entry"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
    <TextView android:id="@+id/oem_status" style="@style/GalaxyUi.TextAppearance.Description" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/cluster_note_padding_vertical" android:paddingBottom="@dimen/cluster_note_padding_vertical"/>
</LinearLayout>
