<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：当前显示状态、原厂增强与自定义仪表入口、enabled 才可见的恢复按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include android:id="@+id/page_header" layout="@layout/include_cluster_page_header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/home_state_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/home_state_row" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_home_current_display"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/home_oem_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/home_oem_entry" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyDescription="@string/cluster_home_oem_entry_description" app:galaxyTitle="@string/cluster_home_oem_entry"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/home_themes_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/home_themes_entry" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyDescription="@string/cluster_home_themes_entry_description" app:galaxyTitle="@string/cluster_home_themes_entry"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
    <com.galaxy.auto.ui.GalaxyActionButton android:id="@+id/home_restore_button" style="@style/GalaxyUi.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_button_margin_top" android:text="@string/cluster_home_restore_button" android:visibility="gone"/>
</LinearLayout>
