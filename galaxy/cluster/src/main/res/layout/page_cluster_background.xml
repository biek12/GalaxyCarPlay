<?xml version="1.0" encoding="utf-8"?>
<!-- 背景页：固定 4 个来源行、状态与动态说明、换图/新选图按钮；可见性由绑定层按当前方案更新。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include android:id="@+id/page_header" layout="@layout/include_cluster_page_header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/background_sources_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/background_source_original" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_background_source_original"/>
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/background_source_image" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_background_source_image"/>
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/background_source_carplay" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_background_source_carplay"/>
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/background_source_local" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_background_source_local"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
    <TextView android:id="@+id/background_status" style="@style/GalaxyUi.TextAppearance.Description" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/cluster_note_padding_vertical" android:paddingBottom="@dimen/cluster_note_padding_vertical"/>
    <TextView android:id="@+id/background_note" style="@style/GalaxyUi.TextAppearance.Description" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/cluster_note_padding_vertical" android:paddingBottom="@dimen/cluster_note_padding_vertical" android:visibility="gone"/>
    <TextView android:id="@+id/background_draft_note" style="@style/GalaxyUi.TextAppearance.Description" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/cluster_note_padding_vertical" android:paddingBottom="@dimen/cluster_note_padding_vertical" android:visibility="gone"/>
    <com.galaxy.auto.ui.GalaxyActionButton android:id="@+id/background_change_image" style="@style/GalaxyUi.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_button_margin_top" android:text="@string/cluster_background_change_image" android:visibility="gone"/>
    <com.galaxy.auto.ui.GalaxyActionButton android:id="@+id/background_pick_new_image" style="@style/GalaxyUi.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_button_margin_top" android:text="@string/cluster_background_pick_new_image" android:visibility="gone"/>
    <com.galaxy.auto.ui.GalaxyActionButton android:id="@+id/background_back_button" style="@style/GalaxyUi.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_button_margin_top" android:text="@string/cluster_background_back_button"/>
</LinearLayout>
