<?xml version="1.0" encoding="utf-8"?>
<!-- 显示设置页：三种日夜外观走公共选择弹窗；当前值由绑定层回填。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include android:id="@+id/page_header" layout="@layout/include_cluster_page_header" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.galaxy.auto.ui.GalaxySettingsCard android:id="@+id/settings_appearance_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/cluster_group_margin_top">
        <com.galaxy.auto.ui.GalaxySettingRow android:id="@+id/settings_appearance_row" android:layout_width="match_parent" android:layout_height="wrap_content" app:galaxyTitle="@string/cluster_settings_appearance_row"/>
    </com.galaxy.auto.ui.GalaxySettingsCard>
</LinearLayout>
