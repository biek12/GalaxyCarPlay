<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 夜间保留文字层级、降低大面积背景亮度；与日间同一套语义名。 -->
    <color name="record_background">#252D38</color>
    <color name="record_background_alt">#252D38</color>
    <color name="record_navigation">#19232F</color>
    <color name="record_navigation_alt">#19232F</color>
    <color name="record_surface">#303B48</color>
    <color name="record_control">#202A36</color>
    <color name="record_border">#414E5D</color>
    <color name="record_divider">#414E5D</color>
    <color name="record_text">#EDF1F6</color>
    <color name="record_muted">#A5AFBD</color>
    <color name="record_disabled">#66FFFFFF</color>
    <color name="record_accent">#1198FF</color>
    <color name="record_accent_soft">#15334C</color>
    <color name="record_selected">#15334C</color>
    <color name="record_ripple">#330088FF</color>
    <color name="record_connected">#5BD379</color>
    <color name="record_warning">#EFB95A</color>
    <color name="record_danger">#EE7A7B</color>
    <color name="record_primary_text">#FFFFFF</color>
    <color name="record_track">#596676</color>
    <color name="record_overlay_scrim">#99000000</color>
    <color name="record_overlay_text">#FFFFFF</color>
    <style name="RecordTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/record_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/record_background</item>
        <item name="android:navigationBarColor">@color/record_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/record_background</item>
    </style>
</resources>
