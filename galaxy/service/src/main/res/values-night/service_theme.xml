    <color name="service_navigation">#1E2732</color>
    <color name="service_surface">#303A47</color>
    <color name="service_border">#3B4756</color>
    <color name="service_foreground">#EDF2F9</color>
    <color name="service_secondary">#A6B4C6</color>
