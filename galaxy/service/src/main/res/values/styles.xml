<?xml version="1.0"?>
<resources>
    <!-- 沿用 ServiceTheme 的 Flyme 色阶与字号层级；尺寸单位 sp/dp 分列。 -->
    <style name="Service.TextAppearance" parent="">
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Service.TextAppearance.Category">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/service_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Service.TextAppearance.HeaderDescription">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.Headline">
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/service_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Service.TextAppearance.Summary">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.MetricLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.MetricValue">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/service_foreground</item>
    </style>
    <style name="Service.TextAppearance.FeaturesFooter">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.RowTitle">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/service_foreground</item>
    </style>
    <style name="Service.TextAppearance.RowDescription">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.RemoteStatus">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/service_foreground</item>
    </style>
    <style name="Service.TextAppearance.Footer">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.DiagnosticTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/service_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Service.TextAppearance.DiagnosticHint">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/service_secondary</item>
    </style>
    <style name="Service.TextAppearance.DiagnosticResult">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/service_foreground</item>
    </style>
    <!-- 运行徽标：初态为等待色，运行态只切换背景资源与文字色。 -->
    <style name="Service.Badge" parent="">
        <item name="android:textAppearance">@style/Service.TextAppearance.MetricLabel</item>
        <item name="android:paddingStart">@dimen/service_badge_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/service_badge_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/service_badge_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/service_badge_padding_vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/service_badge_waiting</item>
    </style>
    <!-- 概览三项指标：固定顺序，只更新数值文本。 -->
    <style name="Service.Metric" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/service_metric_padding</item>
        <item name="android:background">@drawable/service_metric_background</item>
    </style>
    <style name="Service.Button" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/service_foreground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/service_button_height</item>
        <item name="android:paddingStart">@dimen/service_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/service_button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/service_button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/service_button_padding_vertical</item>
        <item name="android:background">@drawable/service_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Service.Input" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/service_foreground</item>
        <item name="android:textColorHint">@color/service_secondary</item>
        <item name="android:background">@drawable/service_input_background</item>
        <item name="android:paddingStart">@dimen/service_input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/service_input_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/service_input_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/service_input_padding_vertical</item>
    </style>
    <style name="Service.Card" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/service_card_padding</item>
    </style>
</resources>
