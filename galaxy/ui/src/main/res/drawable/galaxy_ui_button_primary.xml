<?xml version="1.0"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/galaxy_ui_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/galaxy_ui_corner_radius"/>
                    <solid android:color="@color/galaxy_ui_control"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/galaxy_ui_corner_radius"/>
                    <solid android:color="@color/galaxy_ui_accent"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
