<?xml version="1.0"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/galaxy_ui_ripple">
    <item>
        <selector>
            <item android:state_enabled="false" android:drawable="@android:color/transparent"/>
            <item android:state_hovered="true" android:drawable="@color/galaxy_ui_selected"/>
            <item android:state_focused="true" android:drawable="@color/galaxy_ui_selected"/>
            <item android:drawable="@android:color/transparent"/>
        </selector>
    </item>
</ripple>
