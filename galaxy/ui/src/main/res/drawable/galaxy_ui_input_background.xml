<?xml version="1.0"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/galaxy_ui_corner_radius"/>
            <solid android:color="@color/galaxy_ui_control"/>
            <stroke android:width="1dp" android:color="@color/galaxy_ui_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/galaxy_ui_corner_radius"/>
            <solid android:color="@color/galaxy_ui_control"/>
            <stroke android:width="1dp" android:color="@color/galaxy_ui_border"/>
        </shape>
    </item>
</selector>
