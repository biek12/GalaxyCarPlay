<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/home_icon"
        android:layout_width="@dimen/galaxy_settings_home_icon"
        android:layout_height="@dimen/galaxy_settings_home_icon"
        android:layout_marginBottom="@dimen/galaxy_settings_home_icon_gap"
        android:contentDescription="@string/carplay_icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_carplay" />

    <TextView
        android:id="@+id/home_title"
        style="@style/GalaxySettings.HomeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/l7_entry_title" />

    <TextView
        android:id="@+id/home_help"
        style="@style/GalaxySettings.HomeHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_help_gap"
        android:text="@string/l7_projection_placeholder" />

    <TextView
        android:id="@+id/home_status"
        style="@style/GalaxySettings.HomeHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_status_gap" />

    <com.galaxy.auto.ui.GalaxyActionButton
        android:id="@+id/home_quick"
        style="@style/GalaxyUi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_primary_gap" />

    <com.galaxy.auto.ui.GalaxyActionButton
        android:id="@+id/home_wireless"
        style="@style/GalaxyUi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_button_gap" />

    <com.galaxy.auto.ui.GalaxyActionButton
        android:id="@+id/home_usb"
        style="@style/GalaxyUi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_button_gap" />

    <com.galaxy.auto.ui.GalaxyActionButton
        android:id="@+id/home_settings"
        style="@style/GalaxyUi.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/galaxy_settings_home_button_gap" />
</merge>
